# ===== Sheriff Department Panel — пример .env =====
# Скопируйте этот файл в .env и заполните свои значения.
# БАЗА ДАННЫХ НЕ НУЖНА: SQLite-файл data/panel.db создаётся сам при запуске.

# --- Обязательное ---
# Секрет для подписи сессий (случайная строка 32+ символа). Смените в production!
SESSION_SECRET=change-me-to-random-string-32-chars-min

# --- Первичное создание аккаунта лидера ---
# Вариант 1 (рекомендуется): задайте SETUP_SECRET, откройте панель ->
# страница настройки -> введите секрет и создайте логин/пароль лидера.
SETUP_SECRET=
# Вариант 2: готовый bcrypt-хэш пароля (тогда лидер "leader" создастся сам).
# Получить хэш: node -e "console.log(require('bcryptjs').hashSync('ВАШ_ПАРОЛЬ',10))"
ADMIN_PASSWORD_HASH=

# --- Шифрование URL вебхуков (AES-256-GCM). Рекомендуется задать 32+ символов ---
ENCRYPTION_KEY=

# --- Интеграция Google Forms (Apps Script -> панель) ---
# Секрет, который Apps Script передаёт в заголовке X-Shared-Secret
INTEGRATION_SHARED_SECRET=

# --- Discord-вебхуки (глобальные; формы могут переопределять своими) ---
DISCORD_APPLICATIONS_WEBHOOK_URL=
DISCORD_REPORTS_WEBHOOK_URL=
DISCORD_TECH_WEBHOOK_URL=
DISCORD_STATS_WEBHOOK_URL=
DISCORD_BACKUP_WEBHOOK_URL=

# --- Google API (сервисный аккаунт: создание Google Forms/Docs, бэкапы в Drive) ---
# Вставьте содержимое JSON-ключа сервисного аккаунта одной строкой или укажите путь к файлу
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Прочее ---
# Часовой пояс для статистики/бэкапов (по умолчанию Europe/Moscow)
APP_TIMEZONE=Europe/Moscow
# secure-cookie (оставьте пустым локально; на HTTPS/Railway - true автоматически)
COOKIE_SECURE=
# Раздавать собранный фронтенд из server/dist (true по умолчанию)
SERVE_FRONTEND=
# Разрешённые origins через запятую (пусто =Same-origin)
CORS_ORIGIN=
