# ============================================================
# Sheriff Department Panel — переменные окружения
# Скопируйте в .env (локально) или задайте в Railway → Variables.
# НИКОГДА не коммитьте реальные значения секретов в git.
# ============================================================

# --- Обязательные ---

# Строка подключения к PostgreSQL (Railway: из сервиса PostgreSQL, variable DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Секрет для подписи сессий. Минимум 32 случайных символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Первый вход / начальная настройка ---

# Одноразовый секрет для страницы первоначальной настройки (создание аккаунта лидера).
# Если задан — при первом открытии панель попросит ввести его и задать пароль лидера.
SETUP_SECRET=

# Альтернатива SETUP_SECRET: готовый bcrypt-хэш пароля лидера (логин: leader).
# Генерация: node -e "console.log(require('bcryptjs').hashSync('ВАШ_ПАРОЛЬ', 10))"
# Оставьте пустым, если используете SETUP_SECRET.
ADMIN_PASSWORD_HASH=

# --- Безопасность (рекомендуется) ---

# Ключ шифрования сохраняемых секретов (URL вебхуков форм). 64 hex-символа (32 байта).
# Если не задан — выводится из SESSION_SECRET.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Интеграции ---

# Общий секрет между Google Apps Script и панелью (проверяется заголовком X-Shared-Secret).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTEGRATION_SHARED_SECRET=

# Глобальные Discord-вебхуки по назначениям (пер-формные задаются в конструкторе форм
# и имеют приоритет для ответов конкретной формы).
DISCORD_APPLICATIONS_WEBHOOK_URL=
DISCORD_REPORTS_WEBHOOK_URL=
DISCORD_TECH_WEBHOOK_URL=
DISCORD_STATS_WEBHOOK_URL=
DISCORD_BACKUP_WEBHOOK_URL=

# Google API (сервисный аккаунт). Вставьте содержимое JSON-ключа одной строкой
# ЛИБО укажите путь к файлу ключа.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Сервер ---

PORT=3000
NODE_ENV=production

# Secure-cookie (только https). На Railway https есть — оставьте true.
# Для локального http поставьте false.
COOKIE_SECURE=true

# Отдавать собранный фронтенд из Express (один сервис на Railway). true/false
SERVE_FRONTEND=true

# Дополнительные разрешённые origins для CORS через запятую (для dev: http://localhost:5173)
CORS_ORIGIN=

# Часовой пояс для группировки статистики по дням
APP_TIMEZONE=Europe/Moscow
