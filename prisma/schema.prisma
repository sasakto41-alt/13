// Sheriff Department Panel — Prisma schema (SQLite)
//
// База данных — обычный файл data/panel.db рядом с проектом.
// Сервер БД (PostgreSQL) НЕ нужен: файл создаётся автоматически
// при первом запуске (npm run dev / npm start / npm run setup).
//
// Особенности SQLite:
//  - enum'ы не поддерживаются → статусы хранятся строками:
//      role:               LEADER | DEPUTY | CURATOR | EMPLOYEE
//      status (Employee):  ACTIVE | ON_LEAVE | FIRED
//      status (Form):      DRAFT | ACTIVE | ARCHIVED
//      type (Form):        APPLICATION | REPORT | OTHER
//      status (Submission):NEW | NOTIFIED | NO_EMPLOYEE | NO_FORM | FAILED
//      status (Delivery):  PENDING | SENDING | DELIVERED | FAILED | DEAD
//  - Json не поддерживается → JSON-поля хранятся строками
//    (JSON.stringify/parse через server/src/lib/jsonField.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/panel.db"
}

model Employee {
  id           String   @id @default(cuid())
  fullName     String
  login        String?  @unique
  passwordHash String?
  role         String   @default("EMPLOYEE") // LEADER | DEPUTY | CURATOR | EMPLOYEE
  rank         String?
  division     String?
  status       String   @default("ACTIVE") // ACTIVE | ON_LEAVE | FIRED
  gameId       String?
  discordTag   String?
  hiredAt      DateTime?
  firedAt      DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports     Report[]
  submissions FormSubmission[]

  @@index([fullName])
  @@index([status])
  @@index([division])
}

model Report {
  id          String    @id @default(cuid())
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  type        String    @default("other")
  title       String
  content     String? // JSON: { text } или массив ответов формы
  source      String    @default("manual")
  externalId  String?   @unique
  submittedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@index([submittedAt])
  @@index([type])
}

model Form {
  id            String  @id @default(cuid())
  title         String
  description   String?
  type          String  @default("APPLICATION") // APPLICATION | REPORT | OTHER
  status        String  @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  formKey       String? @unique
  googleFormId  String? @unique
  googleFormUrl String?
  questions     String? // JSON: массив вопросов конструктора

  // ---- Настройки Discord-вебхука этой формы (приоритет над глобальными) ----
  webhookEnabled   Boolean @default(true)
  webhookUrlEnc    String? // URL вебхука хранится зашифрованным (AES-256-GCM)
  webhookUsername  String?
  webhookAvatarUrl String?
  webhookContent   String?
  webhookTitle     String?
  webhookColor     Int?
  webhookFooter    String?
  webhookTimestamp Boolean @default(true)
  webhookMention   String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions FormSubmission[]

  @@index([status])
}

model FormSubmission {
  id         String    @id @default(cuid())
  formId     String?
  form       Form?     @relation(fields: [formId], references: [id], onDelete: SetNull)
  externalId String?   @unique
  answers    String // JSON: массив { question, answer }
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status     String    @default("NEW") // NEW | NOTIFIED | NO_EMPLOYEE | NO_FORM | FAILED
  meta       String? // JSON: formTitle, respondentEmail, submittedAt, matchedBy
  receivedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  deliveryJobs DeliveryJob[]

  @@index([formId])
  @@index([status])
  @@index([receivedAt])
}

model Document {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String?
  googleDocId  String?
  googleDocUrl String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Integration {
  id            String    @id @default(cuid())
  kind          String    @unique
  status        String    @default("not_configured")
  details       String? // JSON
  lastCheckedAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorLogin String?
  actorRole  String?
  action     String
  entity     String?
  entityId   String?
  details    String? // JSON (секреты маскируются при записи)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorLogin])
}

model DeliveryJob {
  id                  String          @id @default(cuid())
  kind                String          @default("discord_webhook")
  targetUrlEnc        String?
  targetUrlMasked     String?
  payload             String // JSON: тело Discord-вебхука
  status              String          @default("PENDING") // PENDING | SENDING | DELIVERED | FAILED | DEAD
  attempts            Int             @default(0)
  maxAttempts         Int             @default(5)
  lastError           String?
  nextAttemptAt       DateTime        @default(now())
  dedupeKey           String?         @unique
  relatedSubmissionId String?
  submission          FormSubmission? @relation(fields: [relatedSubmissionId], references: [id], onDelete: SetNull)
  deliveredAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([nextAttemptAt])
}

model AppSetting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}
